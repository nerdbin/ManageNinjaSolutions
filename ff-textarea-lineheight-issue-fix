add_filter('fluentform/response_render_textarea', function ($value, $field, $formId, $isHtml = false) {
    if (!$isHtml || !is_string($value) || $value === '') {
        return $value;
    }

    $formattedValue = preg_replace(
        '~<br[[:space:]]*/?>[[:space:]]*<br[[:space:]]*/?>~i',
        '<br />',
        $value
    );

    if (!is_string($formattedValue)) {
        return $value;
    }
    return str_replace([chr(13), chr(10)], '', $formattedValue);
}, 20, 4);
