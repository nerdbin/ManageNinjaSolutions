add_filter('fluentform/response_render_textarea', function ($value, $field, $formId, $isHtml = false) {
        if (
            !$isHtml ||
            !is_string($value) ||
            $value === '' ||
            stripos($value, '<br') === false
        ) {
            return $value;
        }

        $value = preg_replace(
            '~<br[[:space:]]*/?>[[:space:]]*<br[[:space:]]*/?>~i',
            '<br />',
            $value
        );

        if (!is_string($value)) {
            return $value;
        }

        // Prevent white-space: pre-line from adding another visual break.
        return str_replace(["\r", "\n"], '', $value);
    },
    20,
    4
);
