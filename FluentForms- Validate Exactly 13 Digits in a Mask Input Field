add_filter('fluentform/validate_input_item_input_text', function ($errorMessage, $field, $formData, $fields, $form) {
    $targetFormId = 122; // Update this with your form ID

    $targetFieldNames = [
        'input_mask', // Update this with your first Mask Input field's Name Attribute
        'input_mask_2', // Update this with your second Mask Input field's Name Attribute
    ];

    $fieldName = $field['name'] ?? '';

    if ((int) $form->id !== $targetFormId ||
        !in_array($fieldName, $targetFieldNames, true)) {
        return $errorMessage;
    }

    $value = trim((string) ($formData[$fieldName] ?? ''));

    // Let the Required rule handle empty values.
    if ($value === '') {
        return $errorMessage;
    }

    if (!preg_match('/^[0-9]{13}$/', $value)) {
        $errors = $errorMessage ? (array) $errorMessage : [];
        $errors[] = 'Please enter exactly 13 digits.';
        return $errors;
    }

    return $errorMessage;
}, 10, 5);
