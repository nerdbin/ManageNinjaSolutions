jQuery(function ($) {
    var formSelector = '#fluentform_16';
    var errorMessage = 'You have not selected any product, select one';
    var errorId = 'ff-standalone-payment-global-error';

    function getForm() {
        return $(formSelector);
    }

    function getStandaloneItems() {
        return getForm().find('.ff-single-payment-item input.ff_payment_item[type="checkbox"]');
    }

    function getActiveStandaloneItems() {
        return getStandaloneItems().filter(function () {
            return !$(this).closest('.ff_excluded').length;
        });
    }

    function hasStandalonePaymentSelected() {
        return getActiveStandaloneItems().filter(':checked').length > 0;
    }

    function clearStandalonePaymentError() {
        $('#' + errorId).remove();
        getForm().find('.ff-single-payment-item').removeClass('ff-el-is-error');
    }

    function showStandalonePaymentError() {
        clearStandalonePaymentError();

        var $error = $('<div />', {
            id: errorId,
            text: errorMessage,
            role: 'alert'
        }).attr(
            'style',
            [
                'display:block!important',
                'position:fixed!important',
                'top:20px!important',
                'left:50%!important',
                'transform:translateX(-50%)!important',
                'z-index:999999999!important',
                'width:calc(100% - 40px)!important',
                'max-width:680px!important',
                'background:#fff5f5!important',
                'color:#b42318!important',
                'border:2px solid #d92d20!important',
                'border-radius:6px!important',
                'padding:14px 18px!important',
                'font-size:16px!important',
                'font-weight:600!important',
                'line-height:1.4!important',
                'box-shadow:0 10px 30px rgba(0,0,0,.18)!important',
                'text-align:left!important'
            ].join(';')
        );

        $('body').append($error);

        getActiveStandaloneItems()
            .closest('.ff-single-payment-item')
            .addClass('ff-el-is-error');

        setTimeout(function () {
            $('#' + errorId).fadeOut(300, function () {
                $(this).remove();
            });
        }, 6000);
    }

    function blockIfInvalid(e) {
        if (hasStandalonePaymentSelected()) {
            clearStandalonePaymentError();
            return true;
        }

        e.preventDefault();
        e.stopPropagation();

        if (typeof e.stopImmediatePropagation === 'function') {
            e.stopImmediatePropagation();
        }

        showStandalonePaymentError();
        return false;
    }

    $(document)
        .off('change.ffSinglePayment', formSelector + ' .ff-single-payment-item input.ff_payment_item[type="checkbox"]')
        .on('change.ffSinglePayment', formSelector + ' .ff-single-payment-item input.ff_payment_item[type="checkbox"]', function () {
            clearStandalonePaymentError();

            if (!this.checked) {
                $(this).closest('.ff-el-form-check').removeClass('ff_item_selected');
                return;
            }

            var current = this;

            getStandaloneItems().not(current).each(function () {
                if (this.checked) {
                    $(this)
                        .prop('checked', false)
                        .closest('.ff-el-form-check')
                        .removeClass('ff_item_selected');

                    $(this).trigger('change');
                }
            });

            $(current).closest('.ff-el-form-check').addClass('ff_item_selected');
        });

    document.addEventListener('click', function (e) {
        var submitButton = e.target.closest(
            formSelector + ' button[type="submit"], ' +
            formSelector + ' input[type="submit"], ' +
            formSelector + ' .ff-btn-submit'
        );

        if (!submitButton) {
            return;
        }

        blockIfInvalid(e);
    }, true);

    var form = document.querySelector(formSelector);

    if (form) {
        form.addEventListener('submit', function (e) {
            blockIfInvalid(e);
        }, true);
    }
});
