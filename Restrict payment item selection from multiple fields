jQuery(document).ready(function ($) {
    var $form = $('#fluentform_3');

    $form.on('change', 'input.ff_payment_item[type="checkbox"]', function () {
        if (!this.checked) {
            return;
        }

        var current = this;

        $form.find('input.ff_payment_item[type="checkbox"]').not(current).each(function () {
            if (this.checked) {
                $(this)
                    .prop('checked', false)
                    .closest('.ff-el-form-check')
                    .removeClass('ff_item_selected')
                    .trigger('change');
            }
        });

        $(current).closest('.ff-el-form-check').addClass('ff_item_selected');
    });
});
