<?php

add_shortcode('ff_people_attending_total', function ($atts = []) {
    global $wpdb;

    $atts = shortcode_atts([
        'form_id' => 75,
        'field'   => 'numeric_field',
        'url'     => ''
    ], $atts, 'ff_people_attending_total');

    $form_id = absint($atts['form_id']);
    $field = sanitize_text_field($atts['field']);
    $source_url = $atts['url'] ? esc_url_raw($atts['url']) : get_permalink();

    if (!$form_id || !$field || !$source_url) {
        return '0';
    }

    $url_variants = array_unique([
        untrailingslashit($source_url),
        trailingslashit($source_url),
    ]);

    $submissions_table = $wpdb->prefix . 'fluentform_submissions';
    $details_table = $wpdb->prefix . 'fluentform_entry_details';

    $placeholders = implode(',', array_fill(0, count($url_variants), '%s'));

    $sql = "
        SELECT SUM(CAST(d.field_value AS DECIMAL(10,2)))
        FROM {$details_table} d
        INNER JOIN {$submissions_table} s ON s.id = d.submission_id
        WHERE s.form_id = %d
        AND s.status != 'trashed'
        AND d.field_name = %s
        AND s.source_url IN ({$placeholders})
    ";

    $total = $wpdb->get_var(
        $wpdb->prepare($sql, array_merge([$form_id, $field], $url_variants))
    );

    return esc_html(number_format_i18n((float) $total));
});
